# Carmel Treinamentos - Configurações de Ambiente

# Banco de dados. Vazio = SQLite local (data/db.sqlite3). Para o PostgreSQL (ex.: Aiven), use a "Service URI":
# DATABASE_URL=postgres://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=require
DATABASE_URL=

# Django
# Em produção: DJANGO_DEBUG=false e uma DJANGO_SECRET_KEY longa e aleatória.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
# Hosts permitidos (separados por vírgula). Adicione o IP da máquina para acesso pela rede.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Necessário atrás de proxy/HTTPS, ex: https://treinamentos.carmel.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=

# HeyGen (o vídeo é gerado pelo Claude com o MCP da HeyGen)
# Avatar e voz usados quando o setor não tem um específico (IDs obtidos na HeyGen)
DEFAULT_AVATAR_ID=
DEFAULT_VOICE_ID=

# Google Drive API
# JSON da Service Account (absoluto ou relativo ao projeto). Precisa de acesso de editor às pastas dos setores (Roteiros/Vídeos),
# de preferência em uma Unidade Compartilhada, pois Service Accounts não têm cota no "Meu Drive".
GOOGLE_SERVICE_ACCOUNT_FILE=data/service_account.json
# Intervalo usado por "manage.py sync_drive --watch"
DRIVE_SYNC_INTERVAL_MINUTES=5

LOG_LEVEL=INFO

# Revisão do roteiro pelo gestor antes de gerar o vídeo (true) ou envio automático (false)
REQUIRE_SCRIPT_REVIEW=true

# Tamanho máximo do MP4 anexado pela tela "Anexar vídeo"
MAX_VIDEO_MB=500

# Conector MCP do portal para o Claude. Vazio = desligado.
# Gere uma chave longa:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# URL do conector: https://SEU-DOMINIO/mcp/<chave>/   (ou /mcp/ com o cabeçalho Authorization: Bearer <chave>)
MCP_TOKEN=
# Domínios aceitos nos links de vídeo que o conector baixa
MCP_ALLOWED_VIDEO_HOSTS=heygen.ai,heygen.com
