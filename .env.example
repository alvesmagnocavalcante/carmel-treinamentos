# Carmel Treinamentos - Configurações de Ambiente

# Django
# Em produção: DJANGO_DEBUG=false e uma DJANGO_SECRET_KEY longa e aleatória.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
# Hosts permitidos (separados por vírgula). Adicione o IP da máquina para acesso pela rede.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Necessário atrás de proxy/HTTPS, ex: https://treinamentos.carmel.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=
MAX_UPLOAD_MB=20

# HeyGen API
HEYGEN_API_KEY=
HEYGEN_API_URL=https://api.heygen.com
# Avatar e voz usados quando o setor não tem um específico (IDs obtidos no painel/API da HeyGen)
DEFAULT_AVATAR_ID=
DEFAULT_VOICE_ID=
# Consulta do status da renderização
HEYGEN_POLL_INTERVAL_SECONDS=20
HEYGEN_POLL_TIMEOUT_MINUTES=30
# Modo simulação (testa a interface sem gastar créditos). Use false para gerar vídeos reais.
HEYGEN_MOCK_MODE=true

# Google Drive API
# JSON da Service Account (absoluto ou relativo ao projeto). Precisa de acesso de editor às pastas dos setores (Roteiros/Vídeos),
# de preferência em uma Unidade Compartilhada, pois Service Accounts não têm cota no "Meu Drive".
GOOGLE_SERVICE_ACCOUNT_FILE=data/service_account.json
# Intervalo usado por "manage.py sync_drive --watch"
DRIVE_SYNC_INTERVAL_MINUTES=5

LOG_LEVEL=INFO

# Revisão do roteiro pelo gestor antes de gerar o vídeo (true) ou envio automático (false)
REQUIRE_SCRIPT_REVIEW=true

# Como o vídeo é gerado depois da aprovação do roteiro:
#   manual (padrão) = o item fica "Aguardando Vídeo"; o vídeo é gerado fora (MCP da HeyGen ou site) e registrado/anexado depois
#   api             = o portal chama a API da HeyGen sozinho (exige saldo de API; o plano Creator não cobre)
HEYGEN_GENERATION_MODE=manual
# Tamanho máximo do MP4 anexado pela tela "Anexar vídeo"
MAX_VIDEO_MB=500
